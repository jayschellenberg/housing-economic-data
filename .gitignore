# Working CSVs from the R pipeline (regenerated by data:all)
/data/

# Cached City-of-Winnipeg census downloads for r/12b (re-fetched on demand)
r/lib/cache/

# Build output
**/dist/

# npm — anywhere in the tree (web/node_modules and any stray root install)
**/node_modules/
package-lock.json
!web/package-lock.json

# Vite caches and dev-server artifacts
**/.vite/
**/vite-dev.*.log
**/vite.config.js.timestamp-*.mjs
**/vitest.config.js.timestamp-*.mjs
**/index.html.tmp.*

# Dropbox / cross-process write-temp side files (e.g. plot-theme.js.tmp.49832...)
**/*.tmp.[0-9]*
**/*.tmp.[0-9]*.*

# Claude Code working-state directory (scheduled tasks lockfile, etc.)
.claude/

# Editor
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.DS_Store
Thumbs.db
*.code-workspace
.idea/
.vscode/

# OS
Desktop.ini

# CMHC per-geography shards — moved to the housing-economic-shards repo
# (2026-09-07) and served through the /gh-data proxy; see web/src/shards.js.
# They are ~401 MB, and Vercel stores the build output of every retained
# deployment separately, so committing them here cost ~400 MB per deploy to
# change one shard. Kept locally because r/03_build_data_files.R writes them
# here before they are copied to the data repo.
/web/public/data/series/
/web/public/data/starts/
